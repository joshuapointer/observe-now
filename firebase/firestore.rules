rules_version = '2';

// Any number of patients: patients/{id}. Each has its own members, so people only ever see the patients they belong to.
// caregiver → full access to the log. In practice this is one shared login per patient on the care device, and the
// person on duty starts a shift by picking their name (patients/{p}/caregivers).
// family → their own logins; read-only, plus notes to the caregiver and acknowledging alerts.
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function patientDoc(p) { return /databases/$(db)/documents/patients/$(p); }
    function memberDoc(p) { return /databases/$(db)/documents/patients/$(p)/members/$(request.auth.uid); }
    // A token only carries the claims for how the account signs in: email (+ email_verified) for email/password
    // and usually Apple, phone_number for a texted code. .get() with a default keeps a missing claim from erroring.
    function email() { return request.auth.token.get('email', '').lower(); }
    function phone() { return request.auth.token.get('phone_number', ''); }
    function provider() { return request.auth.token.get('firebase', {}).get('sign_in_provider', ''); }
    function emailInvite(p) { return /databases/$(db)/documents/invitesByEmail/$(email())/for/$(p); }
    function phoneInvite(p) { return /databases/$(db)/documents/invitesByPhone/$(phone())/for/$(p); }
    // Verified: a confirmed email address, a phone number (confirmed by the code it signed in with), or an Apple
    // account (Apple has verified the person; it may share no email, or a private relay one).
    function verified() {
      return signedIn() && (request.auth.token.get('email_verified', false) == true || phone() != '' || provider() == 'apple.com');
    }
    function invitedAs(p, role) {
      return (email() != '' && exists(emailInvite(p)) && get(emailInvite(p)).data.role == role)
        || (phone() != '' && exists(phoneInvite(p)) && get(phoneInvite(p)).data.role == role);
    }

    function isMember(p) { return signedIn() && exists(memberDoc(p)); }
    function isCaregiver(p) { return isMember(p) && get(memberDoc(p)).data.role == 'caregiver'; }
    function isOwner(p) { return signedIn() && get(patientDoc(p)).data.ownerUid == request.auth.uid; }

    // Subscriptions. Each log has a 14-day trial from when it was created (stamped with the server's clock), then
    // needs a paid-up subscription to keep recording. billing is written only by the Cloud Functions (RevenueCat).
    // Nothing is enforced until config/billing says so, and a lapse only stops new recording: reading, messages,
    // and deleting your own data always work.
    function billingEnforced() {
      return exists(/databases/$(db)/documents/config/billing)
        && get(/databases/$(db)/documents/config/billing).data.get('enforced', false) == true;
    }
    function paidUp(p) {
      let pd = get(patientDoc(p)).data;
      return !billingEnforced()
        || request.time < pd.get('trialStartedAt', timestamp.value(0)) + duration.value(14, 'd')
        || request.time < pd.get('billing', {}).get('until', timestamp.value(0));
    }
    function canRecord(p) { return isCaregiver(p) && paidUp(p); }
    // Safety comes first: a caregiver can always report a fall and alert family, paid up or not.
    function isFall() { return 'FL' in request.resource.data.get('codes', []); }

    match /config/{doc} {
      allow read: if signedIn();
    }

    // "Who do I look after?" list, one per user. It is only a shortcut: real access is always decided by patients/{p}/members.
    match /users/{u}/patients/{p} {
      allow read, write: if signedIn() && u == request.auth.uid;
    }

    // Invitations are filed by the invitee's email, or by their mobile number in E.164 form ("+14155550123",
    // the phone_number claim), so they can find every patient that invited them.
    match /invitesByEmail/{addr}/for/{p} {
      allow get: if isOwner(p) || (verified() && email() == addr);
      allow list: if verified() && email() == addr;
      allow create, update, delete: if isOwner(p);
    }
    match /invitesByPhone/{number}/for/{p} {
      allow get: if isOwner(p) || (verified() && phone() == number);
      allow list: if verified() && phone() == number;
      allow create, update, delete: if isOwner(p);
    }

    match /patients/{p} {
      allow read: if isMember(p);
      // Anyone verified (email or phone) can register a patient and becomes its owner.
      // The trial start, if sent, must be the server's own clock; app versions that don't send it get it stamped by
      // the stampTrial Cloud Function instead. Billing is never set by an app.
      allow create: if verified() && request.resource.data.ownerUid == request.auth.uid
        && (!('trialStartedAt' in request.resource.data) || request.resource.data.trialStartedAt == request.time)
        && !('billing' in request.resource.data);
      allow update: if isCaregiver(p) && request.resource.data.ownerUid == resource.data.ownerUid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['billing', 'trialStartedAt']);
      // Deleting an account deletes the logs it owns (everything below is deleted first, then this).
      allow delete: if isOwner(p);

      match /members/{u} {
        allow read: if isMember(p) || (signedIn() && u == request.auth.uid);
        allow create: if verified() && u == request.auth.uid && (
          // owner bootstrapping, in the same batch that creates the patient
          (request.resource.data.role == 'caregiver' && getAfter(patientDoc(p)).data.ownerUid == u)
          // joining through an invite for this account's verified email address or phone number
          || invitedAs(p, request.resource.data.role)
        );
        allow update: if isOwner(p);
        // The owner removes people; anyone can leave (deleting their account takes them off every log they follow).
        allow delete: if isOwner(p) || (signedIn() && u == request.auth.uid);
      }

      // The invitations this patient's owner has sent (the path of each), so deleting the log can withdraw them.
      match /invitations/{i} {
        allow read, write: if isOwner(p);
      }

      // The caregiver roster for the shared device: names and hashed shift PINs. Families never see it.
      match /caregivers/{c} {
        allow read, write: if isCaregiver(p);
      }

      // Who was on shift when. The live "who's on now" is patients/{p}.onShift.
      match /shiftLog/{s} {
        allow read: if isMember(p);
        allow create, update: if isCaregiver(p);
        allow delete: if isOwner(p);
      }

      match /presence/{u} {
        allow read: if isMember(p);
        allow write: if isMember(p) && u == request.auth.uid;
        allow delete: if isOwner(p) || (signedIn() && u == request.auth.uid);
      }

      // One document per calendar day (id is just the date, e.g. "2026-09-23") — the collection is still
      // named "shifts" because renaming it would orphan any data already written under the old id format
      // (date-plus-shift-name); nothing in the app or its data model calls these "shifts" any more.
      match /shifts/{s} {
        allow read: if isMember(p);
        // The day's own document is scaffolding (created when a caregiver opens the day); updating it records
        // medicines given and the fall report, and only the fall report is allowed without a subscription.
        allow create: if isCaregiver(p);
        allow update: if canRecord(p)
          || (isCaregiver(p) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fall']));
        allow delete: if isOwner(p);

        match /entries/{e} {
          allow read: if isMember(p);
          allow write: if canRecord(p) || (isCaregiver(p) && isFall());
          allow delete: if isOwner(p);
        }

        // Notes marked "keep it off the family feed" live here, so families cannot read them at all.
        match /privateNotes/{e} {
          allow read: if isCaregiver(p);
          allow write: if canRecord(p);
          allow delete: if isOwner(p);
        }

        // Messages both ways: family → caregiver, and caregiver replies (role 'caregiver', caregiver login only).
        match /familyNotes/{n} {
          allow read: if isMember(p);
          allow create: if isMember(p) && request.resource.data.uid == request.auth.uid
            && (request.resource.data.get('role', 'family') != 'caregiver' || isCaregiver(p));
          allow delete: if isOwner(p);
        }

        match /alerts/{a} {
          allow read: if isMember(p);
          allow create: if canRecord(p) || (isCaregiver(p) && request.resource.data.get('kind', '') in ['fall', 'fall-note']);
          allow update: if isCaregiver(p) || (
            isMember(p)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acks'])
            && request.resource.data.acks.diff(resource.data.acks).affectedKeys().hasOnly([request.auth.uid])
          );
          allow delete: if isOwner(p);
        }
      }
    }
  }
}
