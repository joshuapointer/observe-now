{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "dev": {
      "distribution": "internal",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_ENV": "dev"
      }
    },
    "beta": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_ENV": "beta"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_ENV": "prod"
      }
    }
  },
  "submit": {
    "beta": {},
    "production": {}
  }
}
